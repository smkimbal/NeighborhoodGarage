  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.0",
    "leaflet": "1.9.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "deno": "2.6.8",
    "esbuild": "0.25.12",
    "stripe": "22.6.0",
    "supabase": "2.81.3"
  }
}
