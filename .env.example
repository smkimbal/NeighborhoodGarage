# Local API
PORT=8787
NG_DB_PATH=backend/data/neighborhood-garage.sqlite
NG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://smkimbal.github.io
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NG_MASTER_KEY=
NG_COOKIE_SECURE=false
NG_COOKIE_SAMESITE=Lax
NG_STARTING_CREDITS_CENTS=0

# Verification providers (optional locally; dev codes print to the API console)
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# AI image analysis (optional locally; development result used when blank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Payments (optional locally; simulated when blank)
STRIPE_SECRET_KEY=
# Development-only server-side test payment method. Replace with proper hosted/client checkout before production.
STRIPE_TEST_PAYMENT_METHOD=

# Never set this in production unless you explicitly want simulated providers.
NG_ALLOW_SIMULATED_PROVIDERS=false
